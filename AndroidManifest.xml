<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- lets Nirobo Browser install its own updates (Android asks you once to allow it) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- download progress and battery reminders show as notifications (Android 13 and newer ask once) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- only Android 9 needs to ask before saving a download -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- keeps Nirobo's own downloader running while the browser is in the background -->
    <!-- asked only when a website wants them AND the person taps Allow in Nirobo's own prompt -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Without this, Android 11 and newer hides "Search", "Translate" and "Share" from the
         text-selection menu, and the browser cannot see which apps can open a link. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Nirobo Browser"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- lets the phone offer Nirobo Browser when you open a web link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- the download engine's background service (see Downloader.kt) -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- home screen widgets -->
        <receiver
            android:name=".QuickBarWidget"
            android:exported="true"
            android:label="Nirobo quick bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bar" />
        </receiver>
        <receiver
            android:name=".SearchWidget"
            android:exported="true"
            android:label="Nirobo search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_search" />
        </receiver>
        <receiver
            android:name=".AssistantWidget"
            android:exported="true"
            android:label="Nirobo voice search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_assistant" />
        </receiver>
        <receiver
            android:name=".ChargeWidget"
            android:exported="true"
            android:label="Nirobo battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_charge" />
        </receiver>
        <receiver
            android:name=".SpeedWidget"
            android:exported="true"
            android:label="Nirobo speed test">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_speed" />
        </receiver>
        <receiver
            android:name=".NewsWidget"
            android:exported="true"
            android:label="Nirobo saved news">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_news" />
        </receiver>

        <!-- shows downloaded pictures, video, audio, text and web files -->
        <activity
            android:name=".FileViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />

        <!-- the offline PDF reader (opened from the Downloads page) -->
        <activity
            android:name=".PdfReaderActivity"
            android:exported="false" />

        <!-- the private browser: a separate process, so it has its own storage and is erased when closed -->
        <activity
            android:name=".PrivateActivity"
            android:exported="false"
            android:process=":private"
            android:taskAffinity="org.nirobo.browser.private"
            android:launchMode="singleTask"
            android:label="Nirobo Private"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- the sandbox: a locked-down window for links you do not trust. Its own process, its own storage. -->
        <activity
            android:name=".SandboxActivity"
            android:exported="false"
            android:process=":sandbox"
            android:taskAffinity="org.nirobo.browser.sandbox"
            android:launchMode="singleTask"
            android:label="Nirobo Sandbox"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- hears back from Android's installer when an update is installed -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- saves the NewsHub copy at UTC midnight -->
        <receiver
            android:name=".NewsAlarmReceiver"
            android:exported="false" />

        <!-- puts the daily alarm back after the phone restarts -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
